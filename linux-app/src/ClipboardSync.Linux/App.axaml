<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClipboardSync.Linux.App"
             RequestedThemeVariant="Default"
             Name="ClipboardSync.Linux">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/AppIcon.png"
                ToolTipText="Clipboard Sync">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open Clipboard Sync" Click="OnOpenClicked" />
            <NativeMenuItem Header="Send clipboard now" Click="OnSendClipboardClicked" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Quit" Click="OnQuitClicked" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
