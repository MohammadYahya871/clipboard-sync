<Window x:Class="ClipboardSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Clipboard Sync"
        Width="1120"
        Height="820"
        MinWidth="920"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="22"
                CornerRadius="8"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Clipboard Sync"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Border Padding="10,5"
                                CornerRadius="6"
                                Background="#DDECF3"
                                BorderBrush="#BFD7E3"
                                BorderThickness="1">
                            <TextBlock Text="{Binding ConnectionHealthLabel}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentDarkBrush}" />
                        </Border>
                        <Border Margin="8,0,0,0"
                                Padding="10,5"
                                CornerRadius="6"
                                Background="#E7F1EC"
                                BorderBrush="#C9DED3"
                                BorderThickness="1">
                            <TextBlock Text="{Binding PairedDeviceLabel}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding GuidanceText}"
                               Style="{StaticResource MutedText}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Width="260"
                            VerticalAlignment="Center">
                    <CheckBox Content="Sync enabled"
                              IsChecked="{Binding SyncEnabled}"
                              FontWeight="SemiBold" />
                    <Button Margin="0,10,0,0"
                            Content="Sync now"
                            Command="{Binding SendCurrentClipboardCommand}" />
                    <Button Margin="0,8,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Content="Reconnect"
                            Command="{Binding ReconnectCommand}" />
                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding LastActionFeedback}"
                               Style="{StaticResource MutedText}" />
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Margin="0,14,0,0" Columns="4">
            <Border Margin="0,0,10,0"
                    Padding="14"
                    CornerRadius="8"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Connection" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding ConnectionLabel}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,10,0"
                    Padding="14"
                    CornerRadius="8"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Last Item" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding LastItemSummary}" MaxHeight="42" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,10,0"
                    Padding="14"
                    CornerRadius="8"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Sync Mode" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding SyncModeLabel}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>
            <Border Padding="14"
                    CornerRadius="8"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Queue" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding QueueSummary}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="2" Margin="0,16,0,0">
            <TabItem Header="History">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,12,0"
                            Padding="18"
                            CornerRadius="8"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Recent History" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Select an item to copy it here, send it again, or apply a deferred incoming item."
                                           Style="{StaticResource MutedText}" />
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Copy Here"
                                            Command="{Binding RestoreRecentCommand}" />
                                    <Button Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Send Again"
                                            Command="{Binding ResendRecentCommand}" />
                                    <Button Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Apply Deferred"
                                            Command="{Binding ApplyDeferredCommand}" />
                                </StackPanel>
                            </StackPanel>
                            <ListView ItemsSource="{Binding RecentItems}"
                                      SelectedItem="{Binding SelectedRecentItem, Mode=TwoWay}"
                                      MinHeight="360">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Direction" DisplayMemberBinding="{Binding DirectionLabel}" Width="130" />
                                        <GridViewColumn Header="Type" DisplayMemberBinding="{Binding ContentType}" Width="90" />
                                        <GridViewColumn Header="Preview" DisplayMemberBinding="{Binding PreviewText}" Width="360" />
                                        <GridViewColumn Header="State" DisplayMemberBinding="{Binding Status}" Width="110" />
                                        <GridViewColumn Header="Time" DisplayMemberBinding="{Binding SyncedAtUtc}" Width="180" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="18"
                            CornerRadius="8"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Readiness" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ReadinessSummary}" Style="{StaticResource MutedText}" />
                            <Border Margin="0,16,0,0"
                                    Padding="12"
                                    CornerRadius="8"
                                    Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Android note" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="Keep the foreground notification enabled on Android for the most reliable phone-to-PC sync while the app is hidden."
                                               Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,18,0,0" Text="Saved Devices" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Pick a known device when more than one has paired." Style="{StaticResource MutedText}" />
                            <ListView Margin="0,10,0,0"
                                      MinHeight="220"
                                      ItemsSource="{Binding SavedDevices}"
                                      SelectedItem="{Binding SelectedSavedDevice, Mode=TwoWay}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Device" DisplayMemberBinding="{Binding DisplayName}" Width="170" />
                                        <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="95" />
                                        <GridViewColumn Header="Last Seen" DisplayMemberBinding="{Binding LastSeenUtc}" Width="190" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Button Margin="0,10,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Use Selected"
                                    Command="{Binding ConnectSavedDeviceCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Pairing">
                <Border Margin="0,14,0,0"
                        Padding="20"
                        CornerRadius="8"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="332"
                                Height="332"
                                Padding="20"
                                Background="White"
                                BorderBrush="#111111"
                                BorderThickness="1">
                            <Image Source="{Binding PairingQrCodeImage}"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="Pair Another Device" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Scan this QR code from Android. If scanning is difficult, copy the payload and paste it into the phone app."
                                       Style="{StaticResource MutedText}" />
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <Button Content="Copy Payload"
                                        Command="{Binding CopyPairingPayloadCommand}" />
                                <Button Margin="10,0,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Regenerate"
                                        Command="{Binding RegeneratePairingCodeCommand}" />
                            </StackPanel>
                            <TextBox Margin="0,14,0,0"
                                     MinHeight="128"
                                     Text="{Binding PairingPayload, Mode=OneWay}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     IsReadOnly="True" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Settings">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Margin="0,0,12,0"
                            Padding="18"
                            CornerRadius="8"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Sync Behavior" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding SyncModeDescription}" Style="{StaticResource MutedText}" />
                            <ComboBox Margin="0,12,0,0"
                                      ItemsSource="{Binding SyncModes}"
                                      SelectedItem="{Binding SyncMode, Mode=TwoWay}" />
                            <CheckBox Margin="0,16,0,0"
                                      Content="Start with Windows"
                                      IsChecked="{Binding RunAtStartup}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="18"
                            CornerRadius="8"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Content Filters" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding AllowedContentSummary}" Style="{StaticResource MutedText}" />
                            <CheckBox Margin="0,12,0,0" Content="Text" IsChecked="{Binding AllowTextSync}" />
                            <CheckBox Margin="0,8,0,0" Content="URLs" IsChecked="{Binding AllowUrlSync}" />
                            <CheckBox Margin="0,8,0,0" Content="Images" IsChecked="{Binding AllowImageSync}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Width="38"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="-"
                                        Command="{Binding DecreaseImageLimitCommand}" />
                                <TextBlock Margin="10,8,10,0"
                                           Text="{Binding MaxImageSizeMb, StringFormat={}{0} MB maximum}" />
                                <Button Width="38"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="+"
                                        Command="{Binding IncreaseImageLimitCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <Border Margin="0,14,0,0"
                        Padding="18"
                        CornerRadius="8"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Clear Logs"
                                    Command="{Binding ClearLogsCommand}" />
                            <StackPanel>
                                <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Connection and transfer events. Check this tab when sync does not behave as expected."
                                           Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </DockPanel>
                        <ListView ItemsSource="{Binding LogEntries}"
                                  MinHeight="420">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Level" DisplayMemberBinding="{Binding Level}" Width="70" />
                                    <GridViewColumn Header="Time" DisplayMemberBinding="{Binding TimestampUtc}" Width="190" />
                                    <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="700" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="12"
                CornerRadius="8"
                Background="{StaticResource PanelAltBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1">
            <TextBlock Text="Windows remains available in the tray and continues serving inbound sync sessions."
                       Style="{StaticResource MutedText}" />
        </Border>
    </Grid>
</Window>
